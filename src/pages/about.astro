---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { SITE, COMPANIES, STATS, FAQ } from '../data/site';
import { IMAGES } from '../data/images';
import { breadcrumbs, ORG_ID } from '../data/schema';

const title = 'About Civorax Group | Nepali Software & Construction Company';
const description = `Learn about Civorax Group, founded in ${SITE.foundingYear} in Itahari, Nepal — the parent company of CivoraX Tech and CivoraX Infra.`;
const crumbs = [{ name: 'About', path: '/about' }];
---

<Base
  title={title}
  description={description}
  image="design-studio"
  schema={[
    breadcrumbs(crumbs),
    { '@type': 'AboutPage', '@id': `${SITE.url}/about#aboutpage`, url: `${SITE.url}/about`, name: title, mainEntity: { '@id': ORG_ID } },
  ]}
>
  <PageHero
    eyebrow="About us"
    title="About Civorax Group"
    lead={`${SITE.name} is a Nepali holding company founded in ${SITE.foundingYear} and headquartered in Itahari, Koshi Province. We own and run two companies — one that builds software and one that builds buildings.`}
    crumbs={crumbs}
    image="design-studio"
    imageAlt="Civorax Group architects and engineers at work in the Itahari office"
  />

  <section class="section theme-light">
    <div class="container-x grid gap-12 md:grid-cols-12 md:items-center">
      <div class="md:col-span-6">
        <Image src={IMAGES.tower} alt="Commercial building delivered by CivoraX Infra, a Civorax Group company" widths={[640, 960]} sizes="(min-width:768px) 50vw, 100vw" class="screen-img rounded-2xl" />
      </div>
      <div class="prose-dark prose-lg md:col-span-6">
        <h2 class="!mt-0">Our story</h2>
        <p>
          Civorax began in {SITE.foundingYear} with a simple observation: businesses in Nepal were hiring one firm to design their building, another to build it, and a third to supply the software that runs it — and nobody owned the result.
        </p>
        <p>
          We set out to be the partner that does. Today Civorax Group brings together <a href="/companies/civorax-tech">CivoraX Tech</a> and <a href="/companies/civorax-infra">CivoraX Infra</a> under one leadership team, one set of standards and one point of accountability.
        </p>
        <h2>What we believe</h2>
        <ul>
          <li><strong>Build for Nepal.</strong> Seismic design, local materials, Nepali tax rules and real-world connectivity are defaults, not extras.</li>
          <li><strong>Be clear about cost and time.</strong> Fixed scopes, milestone payments and honest timelines.</li>
          <li><strong>Stay after handover.</strong> Buildings need maintenance and software needs updates. We remain your partner.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Brand meaning: Civ + Aura + X -->
  <section id="meaning" class="section" aria-labelledby="meaning-heading">
    <div class="container-x">
      <div class="grid gap-8 md:grid-cols-12 md:items-end">
        <div class="md:col-span-7">
          <p class="eyebrow mb-4">The meaning of CivoraX</p>
          <h2 id="meaning-heading" class="text-[clamp(2.25rem,4.6vw,4.75rem)] font-medium leading-[1.02] tracking-tight text-white">
            The architecture <span class="text-lime">of tomorrow</span>
          </h2>
        </div>
        <p class="text-lg leading-relaxed text-muted md:col-span-5 md:text-xl">
          Our name holds our purpose. We connect civilization with new energy and carry it into the future.
        </p>
      </div>

      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {SITE.nameMeaning.map((m, i) => (
          <li class="card relative flex min-h-[220px] flex-col justify-between overflow-hidden p-8 md:min-h-[clamp(200px,28svh,340px)] md:p-9">
            <span aria-hidden="true" class="wordmark pointer-events-none absolute -right-1 -top-2 text-[clamp(4rem,6.5vw,6.5rem)] opacity-30">{m.part}</span>
            <span class="font-display text-sm font-semibold text-lime">0{i + 1}</span>
            <div class="relative">
              <h3 class="text-2xl font-medium text-white md:text-3xl"><span class="text-lime">{m.part}</span> — {m.word}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-muted md:text-base">{m.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-6 text-center font-display text-xl text-white md:text-2xl">
        Civilization <span class="text-lime">+</span> Energy <span class="text-lime">→</span> Future
      </p>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {COMPANIES.map((c) => (
          <a href={`/companies/${c.slug}`} class="card group flex items-center justify-between gap-4 px-6 py-4 hover:border-lime/50">
            <span>
              <span class="block text-xs uppercase tracking-[0.08em] text-muted">{c.name}</span>
              <span class="mt-1 block text-lg text-white group-hover:text-lime">{c.tagline}</span>
            </span>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line text-lime transition group-hover:rotate-45">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section theme-sage">
    <div class="container-x">
      <dl class="grid grid-cols-2 gap-4 md:grid-cols-4">
        {STATS.map((s) => (
          <div class="card flex flex-col-reverse gap-2 p-6 md:p-8">
            <dt class="text-xs uppercase tracking-[0.08em] text-muted">{s.label}</dt>
            <dd class="font-display text-[clamp(2.25rem,4vw,4rem)] font-semibold leading-none tracking-tight text-white">{s.value}</dd>
          </div>
        ))}
      </dl>

      <h2 class="mt-8 text-[clamp(2rem,3.2vw,3rem)] font-medium tracking-tight text-white">Our companies</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {COMPANIES.map((c) => (
          <article class="card p-7 md:p-8">
            <img src={c.logo} alt={`${c.name} logo`} width="56" height="56" loading="lazy" class="h-14 w-14 rounded-xl bg-[#fff] object-cover" />
            <h3 class="mt-5 text-2xl font-medium text-white md:text-3xl">{c.name}</h3><p class="mt-1 font-display italic text-lime">{c.motto}</p>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{c.description}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <Button href={`/companies/${c.slug}`}>Learn more</Button>
              <Button href={c.url} variant="ghost" external>{c.domain}</Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section theme-moss">
    <div class="container-x">
      <div class="grid gap-10 md:grid-cols-12">
        <h2 class="text-[clamp(2rem,3.6vw,3.5rem)] font-medium leading-[1.08] tracking-tight text-white md:col-span-4">Frequently asked questions</h2>
        <div class="md:col-span-8">
          {FAQ.map((f) => (
            <details class="group border-b border-line py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-white [&::-webkit-details-marker]:hidden">
                <h3 class="font-display text-lg font-medium">{f.q}</h3>
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-lime transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
