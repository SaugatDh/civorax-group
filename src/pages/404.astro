---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found | Civorax Group" description="The page you are looking for does not exist." noindex>
  <section class="flex min-h-[80svh] flex-col items-center justify-center px-5 pt-28 text-center">
    <p aria-hidden="true" class="wordmark text-[40vw] md:text-[18rem]">404</p>
    <h1 class="mt-6 text-3xl font-medium text-white md:text-4xl">This page doesn’t exist</h1>
    <p class="mt-3 text-muted">It may have moved. Try the homepage or get in touch.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/">Go home</Button>
      <Button href="/contact" variant="ghost">Contact us</Button>
    </div>
  </section>
</Base>
