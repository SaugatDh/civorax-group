---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
import { breadcrumbs } from '../data/schema';

const crumbs = [{ name: 'Terms', path: '/terms' }];
---

<Base title="Terms of Use | Civorax Group" description="Terms governing the use of the Civorax Group website." schema={[breadcrumbs(crumbs)]}>
  <PageHero eyebrow="Legal" title="Terms of use" crumbs={crumbs} />
  <section class="section theme-light">
    <div class="container-x prose-dark prose-lg">
      <p><em>Last updated: September 2026.</em> This template must be reviewed by your legal advisor before launch.</p>
      <h2>Using this website</h2>
      <p>This website provides general information about {SITE.name}, CivoraX Tech and CivoraX Infra. It is not an offer or a contract. Project terms are agreed in a separate written agreement.</p>
      <h2>Accuracy</h2>
      <p>We work to keep information accurate, but figures, timelines and project descriptions are summaries and may change.</p>
      <h2>Intellectual property</h2>
      <p>The Civorax name, logos, text, photographs and designs on this site belong to {SITE.name} or its companies and may not be reused without permission.</p>
      <h2>Governing law</h2>
      <p>These terms are governed by the laws of Nepal.</p>
      <h2>Contact</h2>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></p>
    </div>
  </section>
</Base>
