---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { NAV } from '../data/site';

const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/?index$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!-- LIVINOR-style bar: full width, transparent over the hero, gains a dark backdrop once scrolled -->
<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled]:border-line data-[scrolled]:bg-[rgb(12_12_12/0.94)] data-[scrolled]:backdrop-blur-xl">
  <div class="container-x grid h-16 grid-cols-[1fr_auto] items-center gap-4 md:h-20 lg:grid-cols-[1fr_auto_1fr]">
    <Logo />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 font-display text-[13px] font-medium">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-full px-4 py-1.5 transition-colors',
                isActive(item.href) ? 'bg-lime text-ink' : 'text-white/75 hover:text-white',
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center justify-end gap-2">
      <Button href="/contact" class="hidden !py-1.5 !text-[13px] sm:inline-flex">Get in touch</Button>

      <!-- Mobile menu: native <details>, no framework -->
      <details class="group relative lg:hidden">
        <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border border-white/15 bg-white/5 text-white backdrop-blur [&::-webkit-details-marker]:hidden" aria-label="Open menu">
          <Icon name="menu" size={20} class="group-open:hidden" />
          <Icon name="close" size={20} class="hidden group-open:block" />
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 top-14 w-64 rounded-2xl border border-line bg-[#121212] p-3 shadow-2xl">
          <ul class="flex flex-col font-display text-base">
            {NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={['block rounded-xl px-4 py-3', isActive(item.href) ? 'bg-lime text-ink' : 'text-white/80 hover:bg-white/5']}
                >{item.label}</a>
              </li>
            ))}
            <li class="mt-2 sm:hidden"><a href="/contact" class="block rounded-full bg-lime px-4 py-3 text-center font-semibold text-ink">Get in touch</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const h = document.getElementById('site-header');
    const update = () => h.toggleAttribute('data-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>
