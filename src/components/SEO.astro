---
import { getImage } from 'astro:assets';
import { SITE } from '../data/site';
import { IMAGES } from '../data/images';
import { organizationGraph } from '../data/schema';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  /** Path of the social image, relative to site root, or an image key */
  image?: keyof typeof IMAGES;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Extra JSON-LD nodes merged into the page @graph */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  keywords = [
    'Civorax',
    'CivoraX',
    'Civora',
    'Civorax Group',
    'CivoraX Group',
    'Civorax Groups',
    'CivoraX Tech',
    'Civorax Tech',
    'civoraxtech',
    'CivoraX Infra',
    'Civorax Infra',
    'civoraxinfra',
    'civoraxgroup',
    'IT company Nepal',
    'construction company Nepal',
  ],
  image = 'tower',
  imageAlt = `${SITE.name}`,
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/?index$/, '').replace(/\/$/, '') || '/';
const canonical = pathname === '/' ? `${SITE.url}/` : `${SITE.url}${pathname}`;

const og = await getImage({ src: IMAGES[image], width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, SITE.url).href;

const orgId = `${SITE.url}/#organization`;
const websiteId = `${SITE.url}/#website`;

const graph = [
  ...organizationGraph(),
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: SITE.url,
    name: SITE.name,
    alternateName: SITE.alternateNames,
    description: SITE.description,
    inLanguage: SITE.language,
    publisher: { '@id': orgId },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    about: { '@id': orgId },
    primaryImageOfPage: ogUrl,
    inLanguage: SITE.language,
  },
  ...schema,
];

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<meta name="geo.region" content="NP-P1" />
<meta name="geo.placename" content={`${SITE.address.city}, ${SITE.address.countryName}`} />
<meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
<meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />

<script type="application/ld+json" set:html={jsonLd} />
