---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'dark';
  class?: string;
  external?: boolean;
}
const { href, variant = 'primary', class: className = '', external = false } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, className]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  <slot />
  <span class="arrow"><Icon name="arrow-up-right" size={14} /></span>
</a>
